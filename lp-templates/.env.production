# Production build (npm run build:lp on deploy): the forms post to the Worker's /api/lead, which sends each enquiry
# into the CRM (lead-form.js, channel "Motortrade Accountants PPC Landing Pages").
NEXT_PUBLIC_LEAD_ENDPOINT=/api/lead
# Optional absolute or root-relative URL after a successful submission (unset: the form shows a thank-you message).
NEXT_PUBLIC_THANK_YOU_URL=
