{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "motortrade-accountants",
  "compatibility_date": "2026-10-01",
  // Static copy of the WordPress site (./public) behind a small Worker.
  "main": "worker.js",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    // Live WordPress server used for form submissions and missing files.
    // Before pointing themotortradeaccountants.co.uk at this Worker, move
    // WordPress to its own host (e.g. wp.themotortradeaccountants.co.uk) and
    // update this value, or remove it to go fully static.
    "WP_ORIGIN": "https://themotortradeaccountants.co.uk"
  },
  "observability": { "enabled": true }
  // No custom domain yet: the live domain still points at WordPress.
  // Preview address: https://motortrade-accountants.<your-subdomain>.workers.dev
  // To go live later, add:
  // "routes": [
  //   { "pattern": "themotortradeaccountants.co.uk", "custom_domain": true },
  //   { "pattern": "www.themotortradeaccountants.co.uk", "custom_domain": true }
  // ]
}
